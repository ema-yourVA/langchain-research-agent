# Decodo: Dashboard > Web Scraping API > "API Authentication" button.
# Copy the Basic authentication token (with or without the word "Basic").
DECODO_API_TOKEN=

# OpenRouter key, used to reach Claude: https://openrouter.ai/keys
# Leave blank if it is already set in your Windows environment variables.
OPENROUTER_API_KEY=

# Optional settings
MODEL=anthropic/claude-sonnet-5.5
MAX_SEARCHES=3
MAX_PAGES=5
